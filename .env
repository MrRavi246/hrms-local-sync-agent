# ==============================================================================
# CMK HRMS: LOCAL BIOMETRIC SQL SERVER DATABASE SYNC AGENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL SQL SERVER EXPRESS CONNECTION
# ------------------------------------------------------------------------------
# Full ADO.NET Connection String (from SSMS or biometric vendor software)
DB_CONNECTION_STRING="Data Source=DESKTOP-0424DUH\SQLEXPRESS;Persist Security Info=True;User ID=sa;Password=abc@123;Pooling=False;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=False;Application Name=\"SQL Server Management Studio\";Command Timeout=0"

# Extracted SQL Server Connection Parameters
DB_SERVER=DESKTOP-0424DUH\SQLEXPRESS
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_NAME=
DB_USER=sa
DB_PASSWORD=abc@123

# Security options for local SQL Server Express
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=false

# Source Attendance Table Name (default: AttendanceLogs)
SOURCE_TABLE=AttendanceLogs

# ------------------------------------------------------------------------------
# 2. CMK HRMS SERVER API CONFIGURATION
# ------------------------------------------------------------------------------
# Base API URL of deployed CMK HRMS backend
HRMS_API_URL=https://cmkhr.com/api/v1

# Integration Device Secret Token generated in HRMS Admin (Admin -> Integrations -> Attendance Sync)
SYNC_TOKEN=cmk_sync_92373d5af1b3089c57cf2e818ea01c26a43011c21c9ade90

# ------------------------------------------------------------------------------
# 3. DEVICE IDENTIFICATION
# ------------------------------------------------------------------------------
DEVICE_ID=OFFICE-PC-01
DEVICE_NAME=Main Office Biometric Laptop

# ------------------------------------------------------------------------------
# 4. SYNCHRONIZATION RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Polling interval in seconds (default: 60)
SYNC_INTERVAL_SECONDS=60

# Maximum number of attendance records sent per HTTP request batch (default: 500)
SYNC_BATCH_SIZE=500

# Heartbeat interval in seconds (default: 60)
HEARTBEAT_INTERVAL_SECONDS=60

# Dry Run Mode: true to inspect and log without modifying HRMS or advancing cursor
SYNC_DRY_RUN=false

# ------------------------------------------------------------------------------
# 5. LOCAL DIAGNOSTIC AGENT SERVICE
# ------------------------------------------------------------------------------
# Port for the local diagnostic status HTTP server (binds only to 127.0.0.1)
AGENT_PORT=8088

# Logging level: debug | info | warn | error
LOG_LEVEL=info
